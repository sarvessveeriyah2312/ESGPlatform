# Copy to .env and fill in real values before running docker compose.
# cp .env.example .env

# --- Required ---

# Public URL customers reach this instance at (also used as the CORS-allowed origin and in
# outbound emails' links). No trailing slash.
APP_BASE_URL=https://esg.customer-domain.example

# Signing key for JWTs — generate with: openssl rand -base64 48
JWT_SECRET=

# Postgres password for the app's own database user (not the postgres superuser).
DB_PASSWORD=

# --- Optional — defaults shown ---

DB_NAME=esgeasy_esg
DB_USERNAME=esgeasy
HTTP_PORT=80

# SMTP — point at the customer's own mail relay. Leave blank to disable outbound email (invites,
# password reset, verification links won't send).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@customer-domain.example
